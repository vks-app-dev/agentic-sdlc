{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-sdlc/state.schema.json",
  "title": "Agentic SDLC work item (.sdlc/state/REQ-xxx.json)",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "current_stage",
    "stages",
    "tasks",
    "history"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REQ-\\d+$"
    },
    "title": {
      "type": "string"
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "done"
      ]
    },
    "current_stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "stages": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "gate",
          "artifacts",
          "feedback"
        ],
        "properties": {
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "awaiting_approval",
              "approved",
              "skipped",
              "blocked"
            ]
          },
          "gate": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "feedback": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "summary": {
            "type": "string"
          },
          "decision": {
            "type": "object"
          },
          "started": {
            "type": "string"
          },
          "ended": {
            "type": "string"
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "deps",
          "status",
          "attempts",
          "branch"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "deps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "pending",
              "running",
              "in_review",
              "done",
              "failed",
              "blocked"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "branch": {
            "type": "string"
          },
          "log": {
            "type": "array"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ts",
          "what"
        ]
      }
    },
    "type": {
      "enum": [
        "feature",
        "change",
        "bug",
        "task"
      ],
      "description": "work type; missing means feature (items made before work types)"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rel",
          "req"
        ],
        "properties": {
          "rel": {
            "enum": [
              "updates",
              "fixes"
            ]
          },
          "req": {
            "type": "string",
            "pattern": "^REQ-\\d+$"
          }
        }
      }
    },
    "size": {
      "enum": [
        "S",
        "M",
        "L",
        null
      ],
      "description": "set in Requirements with `sdlc size`; for a change it decides whether Design runs"
    }
  }
}
